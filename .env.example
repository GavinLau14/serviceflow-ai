# Copy and fill manually, or run scripts/init-local.sh (random local values).
SERVICEFLOW_DB_PASSWORD=
SERVICEFLOW_ROOT_PASSWORD=
SERVICEFLOW_DEMO_PASSWORD=
# M2: Java->Python internal authentication (generate locally; do not commit .env).
SERVICEFLOW_AI_ENABLED=false
SERVICEFLOW_AI_URL=http://127.0.0.1:18082
SERVICEFLOW_AI_SERVICE_TOKEN=
# Python real local multilingual embeddings (no inference key needed).
AI_QDRANT_URL=http://127.0.0.1:16333
AI_MIN_SCORE=0.45
# Optional OpenAI-compatible LLM: configure all three to enable generative Agent/tool calling.
AI_LLM_API_KEY=
AI_LLM_BASE_URL=https://api.openai.com/v1
AI_LLM_MODEL=

# M4 unified container web entry (loopback only).
SERVICEFLOW_WEB_PORT=18080
